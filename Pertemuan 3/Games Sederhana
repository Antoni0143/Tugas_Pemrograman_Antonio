#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main() {
    srand(time(NULL));
    int skor = 0;
    int salah = 0;
    int soal_ke = 1;

    printf("--- PERMAINAN MATEMATIKA SEDERHANA ---\n");
    printf("\n");
    printf("-- Ketentuan Permainan ---\n");
    printf("1. Permainan Terdiri Dari 30 Soal Matematika Sederhana\n");
    printf("2. Pemain Harus Bisa Menjawab Dengan Benar\n");
    printf("3. Pemain Hanya Memiliki 3x Kesempatan Salah Menjawab\n");
    printf("4. Apabila Ada Lebih Dari 3 Kesalahan Maka Permainan Akan Berakhir\n");
    printf("\n");
    printf("--- Sistem Penilaian ---\n");
    printf("Pada 10 Soal Pertama Memberikan '+5' Point\n");
    printf("Pada 10 Soal Kedua Memberikan '+10' Point\n");
    printf("Pada 10 Soal Terakhir Memberikan '+20' Point\n");
    printf("Pada 10 Soal Terakhir Memberikan '+15' Point\n");
    printf("\n");
    printf("--- Permainan Dimulai! ---\n\n");

    for (soal_ke = 1; soal_ke <= 30 && salah < 3; soal_ke++) {
        int batas_operand = 10;
        int poin_soal = 5;
        
        if (soal_ke > 20) {
            batas_operand = 3\60;
            batas_operand = 50;
            poin_soal = 15; 
        } else if (soal_ke > 10) {
            batas_operand = 30;
            poin_soal = 10;
        }
        int a = (rand() % batas_operand) + 1;
        int b = (rand() % batas_operand) + 1;
        
        int pilih_op = rand() % 4; 
        char operator_char = '+';
        int jawaban_benar = 0;

        if (pilih_op == 0) {
            operator_char = '+';
            jawaban_benar = a + b;
        } 
        else if (pilih_op == 1) {
            operator_char = '-';
            if (a < b) { int temp = a; a = b; b = temp; } 
            jawaban_benar = a - b;
        } 
        else if (pilih_op == 2) {
            operator_char = '*';
            jawaban_benar = a * b;
        } 
        else {
            operator_char = '/';
            if (b == 0) b = 1;
            jawaban_benar = a / b;
            a = b * jawaban_benar; 
        }

        int jawaban_user;
        printf("Soal %d: Berapa %d %c %d ? Jawab: ", soal_ke, a, operator_char, b);
        scanf("%d", &jawaban_user);

        if (jawaban_user == jawaban_benar) {
            printf("--> BENAR! (+%d Poin)\n\n", poin_soal);
            skor += poin_soal;
        } else {
            salah++;
            printf("--> SALAH! Jawaban yang benar adalah %d\n", jawaban_benar);
            printf("Sisa kesempatan salah: %d dari 3\n\n", 3 - salah);
        }
    } 
    printf("---------------------------\n");
    printf("---- PERMAINAN SELESAI ----\n");
    if (salah >= 3) {
        printf("Permainan Berakhir! Anda Telah Salah Sebanyak 3 Kali.\n");
    } else {
        printf("Permainan Berakhir! Anda Telah Menyelesaikan Seluruh Pertanyaan.\n");
    }
    printf("Total Skor Perolehan  : %d\n", skor);
    printf("Total Kesalahan       : %d / 3\n", salah);
    printf("---------------------------------------\n");

    return 0;
}
