biaya = 2 * standar;
}
  else if (stricmp(jenis, "padi") == 0 || stricmp(jenis, "singkong") == 0 || stricmp(jenis, "jagung") == 0) {
    biaya = 1.5 * standar;
}
  else {
    biaya = standar;
}
return biaya;
}
