#include <stdio.h>

int main() {
    
    int x, i, transaksi;
    float biaya_awal, diskon, potongan_diskon, biaya_sementara, biaya_akhir;

    printf("--- Perhitungan Diskon ---\n");
    printf("Masukkan Digit Terakhir NPM (X): ");
    scanf("%d", &x);

    
    for (i = 1; i <= 6; i = i + 1) {
        printf("Masukkan Jumlah Transaksi Cetak Pelanggan ke-%d: ", i);
        scanf("%d", &transaksi);
        
        printf("Masukkan Biaya Awal Pelanggan ke-%d: ", i);
        scanf("%f", &biaya_awal);

        if (transaksi <= 3) {
            diskon = 0.0;     
        } 
        if (transaksi > 3 && transaksi <= 6) {
            diskon = 0.05;    
        } 
        if (transaksi > 6) {
            diskon = 0.10;    
        }

        potongan_diskon = biaya_awal * diskon;
        biaya_sementara = biaya_awal - potongan_diskon;

        if (x % 2 == 0) {
            biaya_akhir = biaya_sementara - 1000;
        } else {
            biaya_akhir = biaya_sementara - 0; 
        }
        printf("Biaya Akhir Pelanggan ke-%d Adalah Rp %f\n", i, biaya_akhir);
    }

    return 0;
}