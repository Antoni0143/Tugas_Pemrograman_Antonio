#include <stdio.h>

int main() {
    int tinggi = 4;
    char huruf = 'A';

    for (int i = 1; i <= tinggi; i++) {
        for (int j = 1; j <= (tinggi - i) * 2; j++) {
            printf(" ");
        }

        for (int k = 1; k <= i; k++) {
            printf("%c ", huruf);
            huruf++;
        }
        printf("\n");
    }
    return 0;
}